# ============================================================
#  rosbag 자동 기록·NAS 업로드 설정 (LG전자, v1.3)
#  사용법: cp robot.env.example robot.env 후 "입력 필요" 항목을 채우고
#          docker run --env-file robot.env ... 로 전달
#
#  작성 규칙 (docker run --env-file 형식)
#  - 값에 따옴표를 쓰지 마세요. 따옴표까지 값으로 들어갑니다.
#  - 주석은 별도 줄에만 쓰세요. 값 옆에 쓰면 주석까지 값이 됩니다.
#  - 주석에 꺾쇠괄호를 쓰지 마세요.
# ============================================================

# ---------- 필수 입력 ----------

# [입력 필요] 로봇 별칭. NAS 폴더 이름으로 쓰임 (robot/lg/stretch01/...)
# 영문 소문자, 숫자, -, _ 만 사용
ROBOT_ID=<LG_ROBOT_ID>

# [입력 필요] 로봇의 ROS_DOMAIN_ID와 반드시 같아야 함 (비어 있으면 0)
ROS_DOMAIN_ID=<LG_ROS_DOMAIN_ID>

# [입력 필요] NAS 주소. IP만 입력 (http://, 포트 번호 없이)
RCLONE_CONFIG_NAS_HOST=<NAS_HOST>

# [입력 필요] NAS 업로드 계정
RCLONE_CONFIG_NAS_USER=<NAS_USER>

# [입력 필요] NAS 비밀번호 변환값 (원래 비밀번호를 그대로 넣으면 안 됨)
# 변환: docker run --rm -i rclone/rclone:1.75.2 obscure -
RCLONE_CONFIG_NAS_PASS=<NAS_PASS_OBSCURED>

# ---------- 선택 (기본값이 이미지에 들어 있음, 바꿀 때만 주석 해제) ----------

# 기록할 토픽 목록 (띄어쓰기로 구분, 따옴표 없이)
# RECORD_TOPICS=/scan /scan_unified /tf /cmd_vel

# bag 하나의 길이(초)
# ROTATE_SEC=300

# bag 전환 시 겹침 시간(초)
# OVERLAP_SEC=5

# ROS 미들웨어
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
