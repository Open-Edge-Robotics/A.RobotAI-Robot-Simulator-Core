# ============================================================
#  rosbag 자동 기록·NAS 업로드 설정 (LG전자)
#  사용법: cp robot.env.example robot.env 후 "입력 필요" 항목을 채우세요.
#  주석은 값 옆이 아닌 별도 줄에 쓰고, 주석에 꺾쇠괄호를 쓰지 마세요.
# ============================================================

# ---------- 로봇 식별 ----------
# 기관명. NAS 폴더 이름의 첫 단계로 쓰임 (robot/lg/...)
ROBOT_ORG=lg

# [입력 필요] 로봇 별칭. NAS 폴더 이름으로 쓰임 (robot/lg/stretch01/...)
# 영문 소문자, 숫자, -, _ 만 사용 (띄어쓰기, / 사용 불가)
# 예) ROBOT_ID=stretch01
ROBOT_ID=<LG_ROBOT_ID>

# ---------- ROS 통신 ----------
# [입력 필요] 로봇의 ROS_DOMAIN_ID와 반드시 같아야 함
# 로봇 ROS 터미널에서 echo $ROS_DOMAIN_ID 로 확인, 비어 있으면 0
# 예) ROS_DOMAIN_ID=0
ROS_DOMAIN_ID=<LG_ROS_DOMAIN_ID>

# ROS 미들웨어. LG 로봇은 CycloneDDS 사용 (변경 불필요)
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# 기록할 토픽 목록. 띄어쓰기로 구분, 큰따옴표로 감쌈
# 예) RECORD_TOPICS="/scan /scan_unified /tf /tf_static /cmd_vel"
RECORD_TOPICS="/scan /scan_unified /tf /cmd_vel"

# ---------- 기록 방식 ----------
# bag 하나의 길이(초). 300 = 5분마다 새 파일
ROTATE_SEC=300

# bag 전환 시 앞뒤 기록을 겹치는 시간(초). 전환 중 데이터 누락 방지
OVERLAP_SEC=5

# 폴더 이름에 쓰는 시간대. 한국 시간 (변경 불필요)
TZ=KST-9

# ---------- NAS 업로드 ----------
# NAS 접속 방식 (변경 불필요)
RCLONE_CONFIG_NAS_TYPE=smb

# [입력 필요] NAS 주소. IP만 입력 (http://, 포트 번호 붙이지 않음)
# 예) RCLONE_CONFIG_NAS_HOST=192.168.0.10
RCLONE_CONFIG_NAS_HOST=<NAS_HOST>

# [입력 필요] NAS 업로드 계정 (이노그리드 제공)
# 예) RCLONE_CONFIG_NAS_USER=robot_uploader
RCLONE_CONFIG_NAS_USER=<NAS_USER>

# [입력 필요] NAS 비밀번호를 변환한 값 (원래 비밀번호를 그대로 넣으면 안 됨)
# 변환 명령: docker run --rm -i rclone/rclone:1.75.2 obscure -
# 예) RCLONE_CONFIG_NAS_PASS=Xk3mF9aQ2vLp8RtY1nWc0dHsJ5eB
RCLONE_CONFIG_NAS_PASS=<NAS_PASS_OBSCURED>
